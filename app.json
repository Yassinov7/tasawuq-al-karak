{
  "expo": {
    "name": "تسوق",
    "slug": "tasawuq-al-karak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/branding/taswoq-icon-light.png",
    "scheme": "taswoqalkarak",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FCFBF7",
    "primaryColor": "#2F6B3C",
    "ios": {
      "icon": "./assets/images/branding/taswoq-icon-light.png"
    },
    "android": {
      "package": "com.yassinov77.tasawuqalkarak",
      "adaptiveIcon": {
        "backgroundColor": "#0D100E",
        "foregroundImage": "./assets/images/branding/taswoq-icon-dark.png",
        "monochromeImage": "./assets/images/branding/taswoq-icon-dark.png"
      },
      "backgroundColor": "#0D100E",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/branding/taswoq-icon-light.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFBF7",
          "image": "./assets/images/branding/taswoq-logo-light.png",
          "imageWidth": 210,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0D100E",
            "image": "./assets/images/branding/taswoq-logo-dark.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يتيح التطبيق الوصول إلى صورك لاختيار صور المنتجات ومقاطع الفيديو للمتجر.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "defaultChannel": "operations",
          "color": "#2F6B3C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87e445c0-70dc-494b-9dea-fe0e69d109ef"
      }
    },
    "owner": "yassinov77"
  }
}
